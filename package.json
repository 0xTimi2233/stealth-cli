{
  "name": "stealth-cli",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "check": "biome check . && tsc --noEmit",
    "build:js": "bun build --target=bun --minify --external playwright-core src/features/cli/cli.ts --outfile dist/stealth-cli.js",
    "build": "bun run build:js && bun build --compile --minify --external playwright-core --target=bun-darwin-arm64 src/features/cli/cli.ts --outfile dist/stealth-cli"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.11",
    "@types/bun": "latest",
    "playwright-core": "^1.62.1"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "dependencies": {
    "cloakbrowser": "^0.5.9"
  }
}
